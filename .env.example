# Default database: embedded PostgreSQL in ./data/paper (no Docker required).
# DATABASE_URL=postgresql://swarm:swarm@localhost:5432/swarm
DATA_DIR=./data/paper
PORT=4310
USER_AGENT=investment-swarm/0.1 (local weather research)
# Optional: authenticated, read-only market streaming. Never put keys in agent tools.
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=
# Optional Eve research calls; the paper engine works without any model account.
# AI_GATEWAY_API_KEY=
# SWARM_RESEARCH_MODEL=openai/gpt-5-mini
# Live execution is deliberately unavailable in this release.
TRADING_MODE=paper
